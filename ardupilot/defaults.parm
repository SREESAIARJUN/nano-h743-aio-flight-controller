# Nano H743 AIO - default parameters (Revision 10.0)
# Integrated 4-in-1 ESC: bidirectional DShot600 on TIM1 CH1..CH4 (AM32 + EDT)
# Every name/value here is checked against the ArduPilot source tree by
# python3 tools/validate_bdshot.py --ardupilot <tree>.

# --- motor protocol --------------------------------------------------------
MOT_PWM_TYPE 6
SERVO_BLH_AUTO 1
SERVO_BLH_BDMASK 15
# 12N14P motors; must equal MOTOR_POLES in am32_esc/am32_target.h
SERVO_BLH_POLES 14
# 3 = BLHeli32/AM32/Kiss + Extended DShot Telemetry. AM32 then interleaves
# temperature / voltage / current EDT frames with eRPM frames on the same
# wire, giving per-ESC temperature without a serial telemetry pin.
SERVO_DSHOT_ESC 3
# Rev 10.0: DShot frame rate = 4 x SCHED_LOOP_RATE (400 Hz) = 1600 Hz,
# loop-synchronous.  The default 0 runs a free 1 kHz timer that beats against
# the 400 Hz loop.  All four motors share TIM1 and ArduPilot captures ONE
# motor's eRPM reply per frame (round-robin), so each motor's RPM refreshes
# at 1600 / 4 = 400 Hz (2.5 ms).  3 (1200 Hz) leaves the notch 43 Hz behind
# a full-throttle punch, more than INS_HNTCH_BW; see analysis/bdshot_report.json.
# If SCHED_LOOP_RATE is raised, lower this so loop x rate stays <= 4096 Hz.
SERVO_DSHOT_RATE 4

# --- RPM-driven harmonic notch from bidir DShot eRPM -----------------------
INS_HNTCH_ENABLE 1
# 3 = ESC telemetry
INS_HNTCH_MODE 3
# REF is only a scale for the single-source (averaged) case; 1 = no scaling
INS_HNTCH_REF 1
# In ESC mode FREQ is the minimum notch frequency.  Below FREQ the notch is
# held at FREQ and its attenuation faded out; below FREQ/4 it is disabled.
INS_HNTCH_FREQ 80
INS_HNTCH_BW 40
INS_HNTCH_ATT 40
# 1st + 2nd harmonic.  2nd harmonic of motors above 480 Hz (28.8k RPM) is
# above the 960 Hz Nyquist guard at INS_GYRO_RATE 2 kHz and is skipped.
INS_HNTCH_HMNCS 3
# Rev 10.0: 6 = Multi-Source (bit1, one notch set per motor) + update at loop
# rate (bit2).  Rev 6..9 used 2, which re-centres the notches at 200 Hz only.
INS_HNTCH_OPTS 6

# --- logging ---------------------------------------------------------------
# microSD logging on SDMMC1 (IDMA)
LOG_BACKEND_TYPE 1
