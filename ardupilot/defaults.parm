# Nano H743 AIO - default parameters (Revision 10.0)
# Integrated 4-in-1 ESC: bidirectional DShot600 on TIM1 CH1..CH4 (AM32 + EDT)
# Every name/value here is checked against the ArduPilot source tree by
# python3 tools/validate_bdshot.py --ardupilot <tree>.

# --- motor protocol --------------------------------------------------------
MOT_PWM_TYPE 6
SERVO_BLH_AUTO 1
SERVO_BLH_BDMASK 15
# 12N14P motors (physical magnet count).  The FC alone converts eRPM -> RPM
# (erpm*200/POLES), so this sets the notch frequency.  Must equal motor_poles in
# am32_esc/eeprom_settings.json (same motor; checked by am32_esc/gate_drive_design.py
# E1 and analysis/bdshot_timing_analysis.py B16)
SERVO_BLH_POLES 14
# 3 = BLHeli32/AM32/Kiss + Extended DShot Telemetry.  ArduPilot then sends
# DShot command 13 at start-up; AM32 (EDT off until it gets that command)
# interleaves temperature / voltage / current EDT frames with eRPM frames on
# the same wire - per-ESC temperature without a serial telemetry pin.
SERVO_DSHOT_ESC 3
# Rev 10.0: DShot frame rate = 4 x SCHED_LOOP_RATE (400 Hz) = 1600 Hz, one
# frame every 625 us, phase-locked to the loop.  The default 0 sends on every
# loop push plus 1 ms timer ticks re-armed by each push: ~1.2 kHz with uneven
# 1 / 1 / 0.5 ms spacing.  All four motors share TIM1 and ArduPilot captures
# ONE motor's eRPM reply per frame (round-robin), so each motor's RPM
# refreshes every 2.5 ms (400 Hz), the fastest of rates 0..4.  No rate keeps
# the notch inside INS_HNTCH_BW during a full-throttle punch (lag >= 75 Hz,
# analysis/bdshot_report.json), so that is not the selection criterion.
# If SCHED_LOOP_RATE is raised, ArduPilot clamps loop x rate to <= 4096 Hz.
SERVO_DSHOT_RATE 4

# --- RPM-driven harmonic notch from bidir DShot eRPM -----------------------
INS_HNTCH_ENABLE 1
# 3 = ESC telemetry
INS_HNTCH_MODE 3
# REF is only a scale for the single-source (averaged) case; 1 = no scaling
INS_HNTCH_REF 1
# In ESC mode FREQ is the minimum notch frequency.  Below FREQ the notch is
# held at FREQ and its attenuation faded out; below FREQ/4 it is disabled.
INS_HNTCH_FREQ 80
INS_HNTCH_BW 40
INS_HNTCH_ATT 40
# 1st + 2nd harmonic.  2nd harmonic of motors above 480 Hz (28.8k RPM) is
# above the 960 Hz Nyquist guard at INS_GYRO_RATE 2 kHz and is skipped.
INS_HNTCH_HMNCS 3
# Rev 10.0: 6 = Multi-Source (bit1, one notch set per motor) + update at loop
# rate (bit2).  Rev 6..9 used 2: without bit2 the notch is re-centred only when
# >5 ms have passed, i.e. every 3rd 2.5 ms loop (~133 Hz at SCHED_LOOP_RATE 400).
INS_HNTCH_OPTS 6

# --- ESC gate-driver supply floor (Rev 9.0) ---------------------------------
# The FD6288Q gate drivers run from VBAT; below ~5.95 V the high-side bootstrap
# supply drops under the driver UVLO (5.0 V max) and that ESC stops driving.
# AM32's own low-voltage cutoff is disabled (am32_esc/eeprom_settings.json):
# it latches one motor off until power cycle.  This absolute floor applies
# for any cell count (3.2 V/cell on 2S, never reached first on 3S/4S); set
# BATT_LOW_VOLT / a higher BATT_CRT_VOLT for the actual pack.
# Checked by am32_esc/gate_drive_design.py E3.
BATT_CRT_VOLT 6.4
# 1 = Land
BATT_FS_CRT_ACT 1

# --- logging ---------------------------------------------------------------
# microSD logging on SDMMC1 (IDMA)
LOG_BACKEND_TYPE 1

# --- digital VTX BEC (Rev 13.0) --------------------------------------------
# RELAY2 = VTX_PWR (GPIO 81, U6 EN).  Must be 1: AP_Relay::init() drives the
# pin to RELAYn_DEFAULT and would otherwise switch the VTX off at boot.
RELAY2_DEFAULT 1
# RELAY3 = VTX_12V_SEL (GPIO 82).  0 = 9 V (safe for HDZero 12 V max and the
# only regulated setting on 3S).  12 V is a 4S-only mode: see
# ardupilot/scripts/vtx_bec.lua (VBAT interlock) before setting it.
RELAY3_DEFAULT 0
# BEC output sense: PC5 = ADC12_INP8 through R40 10k / R41 1k (x11.0)
BATT2_MONITOR 1
BATT2_VOLT_PIN 8
BATT2_VOLT_MULT 11.0

# --- DroneCAN on CAN1 (Rev 14.0) ---------------------------------------------
# U7 TCAN334G on FDCAN1, split 120R termination fitted (JP1/JP2 bridged: the FC
# is one end of the bus), J3 JST-GH DroneCAN connector.
# analysis/can_phy_analysis.py checks these against the hardware (M5, T1, T3).
CAN_P1_DRIVER 1
CAN_D1_PROTOCOL 1
# Arbitration phase 1 Mbit/s: ArduPilot computeTimings() at 80 MHz -> BRP 8,
# 10 tq, sample point 90 %.  Exact, oscillator tolerance x111 over the Y1 budget.
CAN_P1_BITRATE 1000000
# FD data phase if CAN_D1_UC_OPTION bit 2 (EnableCanfd) is set; 1/2/4/5 are
# legal on the TCAN334G, never 8.  FD itself is left OFF: most DroneCAN
# peripherals are classic CAN, and one classic node on an FD bus error-frames
# every FD frame.
CAN_P1_FDBITRATE 4
