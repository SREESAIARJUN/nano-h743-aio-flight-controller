# hwdef-bl.dat - bootloader for the Nano H743 AIO (Revision 7.0)
# Sreesai Arjun Engineering - reviewed for Revision 13.0 / 150
#
# Rev 13.0 (AT7456E OSD on SPI2, digital VTX BEC) - no functional change:
#  - OSD1_CS (PB12) is already held high below (CS = output, ODR high,
#    pull-up), so U5 AT7456E never drives SDOUT/PB14 while the bootloader
#    runs; SPI2 itself is not configured here.
#  - PD10 VTX_PWR and PD11 VTX_12V_SEL are deliberately NOT listed: the
#    generated bootloader hwdef.h leaves them INPUT / floating (as after
#    reset, where H7 GPIOs are analog high-Z), so
#      U6 TPS62933 EN: internal pull-up (Ip 0.7 uA, TPS62933 DS Electrical
#        Characteristics "ENABLE"; Pin Functions: "leaving this pin floating
#        enables the converter") through R39 1k  -> BEC ON,
#      Q1 gate: R38 100k pull-down                -> OFF -> +VTX = 8.96 V.
#    The VTX keeps video at the 9 V-safe setting through reset, bootloader,
#    DFU and firmware update; the firmware (hwdef.dat OUTPUT HIGH / LOW,
#    RELAY2_DEFAULT 1, RELAY3_DEFAULT 0) takes over with the same levels.
#    Do not add PD10 here as OUTPUT LOW: that would switch the VTX off
#    during every boot / firmware update.
#  - PC5 VTX_VSENSE and PE7 UART7_RX are unused by the bootloader.
#  Checked by tools/validate_osd_vtx.py (V1).

MCU STM32H7xx STM32H743xx

# PROVISIONAL board ID - must match hwdef.dat (see note there)
APJ_BOARD_ID 5743

# must match hwdef.dat: 24 MHz HSE (Rev 7.0)
OSCILLATOR_HZ 24000000

FLASH_SIZE_KB 2048

# bootloader occupies sector 0; firmware loads at 128 kB (sector 1)
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128

# bootload over USB and SERIAL1 (USART1). The bootloader is single-threaded
# and polled, so no DMA is used on any peripheral here.
SERIAL_ORDER OTG1 USART1

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA9  USART1_TX USART1 NODMA
PA10 USART1_RX USART1 NODMA

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

PE3 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 0

# hold every SPI chip-select high so no device drives MISO during boot
PA4  IMU1_CS CS
PE4  IMU2_CS CS
PB12 OSD1_CS CS

# flash firmware from microSD (SDMMC1, IDMA - no DMA stream needed)
define CH_CFG_USE_MEMCORE 1
define CH_CFG_USE_HEAP 1
define CH_CFG_USE_SEMAPHORES 0
define CH_CFG_USE_MUTEXES 1
define CH_CFG_USE_DYNAMIC 1
define CH_CFG_USE_WAITEXIT 1
define CH_CFG_USE_REGISTRY 1

PC8  SDMMC1_D0  SDMMC1
PC9  SDMMC1_D1  SDMMC1
PC10 SDMMC1_D2  SDMMC1
PC11 SDMMC1_D3  SDMMC1
PC12 SDMMC1_CK  SDMMC1
PD2  SDMMC1_CMD SDMMC1
define HAL_OS_FATFS_IO 1
define AP_BOOTLOADER_FLASH_FROM_SD_ENABLED 1
