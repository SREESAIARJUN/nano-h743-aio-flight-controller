# hwdef.dat for STM32H743VIT6 Nano AIO Flight Controller + 4-in-1 ESC
# Sreesai Arjun Engineering (ArduPilot / PX4 Target)

MCU STM32H743xx STM32H743VITx
define CONFIG_HAL_BOARD_SUBTYPE HAL_BOARD_SUBTYPE_CHIBIOS_NANO_H743_AIO

# 480 MHz Core Clock & 25MHz external HSE crystal
OSCILLATOR_HZ 25000000
STM32_PLLM_VALUE 5
STM32_PLLN_VALUE 192
STM32_PLLP_VALUE 2
STM32_PLLQ_VALUE 4
STM32_PLLR_VALUE 2

# Flash size 2MB, RAM 1MB
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128

# IMU 1 (Primary): ICM-42688-P on SPI1
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PA4 ICM42688_CS CS
PC4 ICM42688_EXTI INPUT
SPIDEV icm42688 SPI1 SPEED_LOW 2*MHZ SPEED_HIGH 20*MHZ CS_PIN PA4
IMU Invensensev3:icm42688 ROTATION_NONE

# IMU 2 (Secondary Auxiliary): ICM-42688-P on SPI4
PE2 SPI4_SCK SPI4
PE5 SPI4_MISO SPI4
PE6 SPI4_MOSI SPI4
PE4 ICM42688_2_CS CS
SPIDEV icm42688_2 SPI4 SPEED_LOW 2*MHZ SPEED_HIGH 20*MHZ CS_PIN PE4
IMU Invensensev3:icm42688_2 ROTATION_PITCH_180

# Barometer: DPS310 on I2C1
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1
I2C_ORDER I2C1
BARO DPS310:0 I2C:0:0x76

# OSD: AT7456E on SPI2
PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2
PB12 AT7456E_CS CS
SPIDEV osd SPI2 SPEED_LOW 2*MHZ SPEED_HIGH 10*MHZ CS_PIN PB12
OSD_ENABLED 1

# DroneCAN / UAVCAN on FDCAN1
PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1
CAN_ORDER 1

# MicroSD Slot (SDMMC1 4-bit)
PC8 SDMMC1_D0 SDMMC1
PC9 SDMMC1_D1 SDMMC1
PC10 SDMMC1_D2 SDMMC1
PC11 SDMMC1_D3 SDMMC1
PC12 SDMMC1_CK SDMMC1
PD2 SDMMC1_CMD SDMMC1

# Integrated 4-in-1 ESC DShot600 outputs (TIM1 & TIM8 Bidirectional DShot)
PE9  TIM1_CH1 TIM1 PWM(1) GPIO(50) BIDIR_DSHOT_DMA
PE11 TIM1_CH2 TIM1 PWM(2) GPIO(51) BIDIR_DSHOT_DMA
PE13 TIM1_CH3 TIM1 PWM(3) GPIO(52) BIDIR_DSHOT_DMA
PE14 TIM1_CH4 TIM1 PWM(4) GPIO(53) BIDIR_DSHOT_DMA

# Analog Battery Voltage & Current Sense
PC0 BATT_VOLTAGE_SENS ADC1 SCALE(10.9)
PC1 BATT_CURRENT_SENS ADC1 SCALE(50.0)

# Serial Ports
# UART1: DJI O3 / Digital VTX
PA9  USART1_TX USART1
PA10 USART1_RX USART1

# UART2: RC Receiver (CRSF / ELRS)
PD5 USART2_TX USART2
PD6 USART2_RX USART2

# UART3: GPS + Compass
PD8  USART3_TX USART3
PD9  USART3_RX USART3
